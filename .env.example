# FAKE example values. Copy to .env (git-ignored) and fill in your own SANDBOX app credentials.
PAYPAL_CLIENT_ID=fake-sandbox-client-id
PAYPAL_CLIENT_SECRET=fake-sandbox-client-secret
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=FAKEWEBHOOKID123
DATABASE_URL=postgres://user:password@localhost:5432/guardian_pay
PORT=3000
# Auth / safeguards (fake values)
GP_TOKEN_SECRET=fake-token-secret-change-me-0123456789
# GP_TOKEN_FAMILY_DEMO=gp_replace-with-a-random-string-of-32-or-more-chars
ENABLE_ADMIN_ROUTES=false
# ADMIN_TOKEN=fake-admin-token-32-chars-minimum-0000
ALLOW_SANDBOX_CARD=true
# Payee verification (fake values; all optional)
PAYEE_ONBOARDING_MODE=auto
# PAYPAL_PARTNER_MERCHANT_ID=FAKEPARTNERID1
PAYEE_CHANGE_COOLING_HOURS=72
PAYEE_VERIFY_MAX_AGE_HOURS=24
PAYEE_REFRESH_SECONDS=300
